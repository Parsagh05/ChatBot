# Solar Panel Chatbot - Environment Configuration
# Everything except ADMIN_PASSWORD and the paths can also be changed at runtime
# from the admin dashboard (frontend/admin.html); dashboard changes are saved in
# backend/data/runtime_settings.json and override the values here.

# Admin dashboard password. The dashboard is disabled while this is empty.
ADMIN_PASSWORD=

# LLM provider: auto (gemini* model names use Gemini, others OpenAI-compatible), openai, or gemini
LLM_PROVIDER=auto
LLM_MODEL=gpt-4o-mini

# OpenAI-compatible API (TapSage: https://api.tapsage.com/openai/v1, OpenAI: https://api.openai.com/v1, Ollama: http://localhost:11434/v1)
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.tapsage.com/openai/v1

# Gemini API (Google: https://generativelanguage.googleapis.com, or a compatible gateway)
GEMINI_API_KEY=
GEMINI_API_ENDPOINT=https://api.tapsage.com

# Retrieval and generation
EMBEDDING_MODEL=paraphrase-multilingual-mpnet-base-v2
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=6
TEMPERATURE=0.5
MAX_TOKENS=1000

# Knowledge sources: the website is fetched through its WordPress/WooCommerce APIs
SITE_URL=https://tabenergy.ir
KNOWLEDGE_BASE_DIR=../knowledge_base

# Generated data, relative to backend/
CHROMA_DB_PATH=../chroma_db
CHROMA_COLLECTION_NAME=farsi_rag_collection
PRODUCT_DB_PATH=products.db
DATA_DIR=data

# Server configuration
CORS_ORIGINS=http://localhost:8080,http://localhost:3000,http://127.0.0.1:5500
RATE_LIMIT_PER_MINUTE=20
HOST=0.0.0.0
PORT=8000
