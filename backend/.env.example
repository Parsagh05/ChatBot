# Solar Panel Chatbot - Environment Configuration

# LLM API settings
# OpenAI-compatible API key. Also used as Gemini fallback if GEMINI_API_KEY is empty.
OPENAI_API_KEY=your-api-key-here

# OpenAI-compatible API endpoint URL
# TapSage: https://api.tapsage.com/openai/v1
# OpenAI:  https://api.openai.com/v1
# Ollama:  http://localhost:11434/v1
OPENAI_BASE_URL=https://api.tapsage.com/openai/v1

# Gemini API settings. Used automatically when LLM_MODEL starts with "gemini".
GEMINI_API_KEY=
GEMINI_API_ENDPOINT=https://api.tapsage.com

# Model name. "gemini..." uses Gemini; other names use the OpenAI-compatible client.
LLM_MODEL=gpt-4o-mini

# Database paths, relative to backend/
CHROMA_DB_PATH=../chroma_db
CHROMA_COLLECTION_NAME=farsi_rag_collection
KNOWLEDGE_BASE_DIR=../knowledge_base
PRODUCT_DB_PATH=products.db

# Server configuration
CORS_ORIGINS=http://localhost:8080,http://localhost:3000,http://127.0.0.1:5500
HOST=0.0.0.0
PORT=8000
